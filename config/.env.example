# Copy this file to .env. Do not commit .env.
# Use absolute paths or ~. Values do not support variable substitution.
DEVWARDEN_ROOT=~/code
# The schedule uses the system time zone unless you add a named time zone.
DEVWARDEN_CALENDAR="Fri *-*-* 06:00:00"
DEVWARDEN_RETENTION_DAYS=90
# Email is optional. Leave sender and recipient empty for local reports only.
DEVWARDEN_SMTP_HOST=smtp.gmail.com
DEVWARDEN_SMTP_PORT=465
DEVWARDEN_SMTP_SECURITY=ssl
DEVWARDEN_SMTP_SENDER=
DEVWARDEN_SMTP_RECIPIENT=
DEVWARDEN_SMTP_USERNAME=
# Prefer the hidden prompt: devwarden email-configure.
# If you set a password here, protect this file and never commit it.
DEVWARDEN_SMTP_PASSWORD=
